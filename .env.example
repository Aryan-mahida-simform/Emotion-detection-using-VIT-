# Copy to .env and adjust. Every value has a default in app/config.py.

# auto prefers the ViT checkpoint, then falls back to the reference scorer.
# vit fails at startup when the checkpoint cannot be loaded. reference never loads one.
EMOTION_API_BACKEND=auto

# Any ViTForImageClassification checkpoint with facial emotion labels.
EMOTION_API_MODEL_ID=dima806/facial_emotions_image_detection

# auto, cpu or cuda
EMOTION_API_DEVICE=auto

# Leave false in production: server start should not fetch weights over the network.
EMOTION_API_ALLOW_MODEL_DOWNLOAD=false

EMOTION_API_WARMUP_ON_START=true
EMOTION_API_LOG_LEVEL=INFO
EMOTION_API_MAX_IMAGE_BYTES=8388608
EMOTION_API_MAX_BATCH_SIZE=8
EMOTION_API_DEFAULT_TOP_K=3
EMOTION_API_CORS_ORIGINS=*
